<?xml version="1.0" encoding="utf-8"?>
<!-- Android cannot list IP ranges here, so cleartext is allowed at the platform
     level and narrowed in code: every request goes through sync/NetGuard, which
     allows plain HTTP only to private-LAN hosts and only to the paired hub.
     MapLibre tiles and PBDB use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
